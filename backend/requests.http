# VS Code "REST Client" extension -> click "Send Request"

@host = http://localhost:3000/api
@token = paste-the-token-from-register-or-login-here

###
POST {{host}}/auth/register
content-type: application/json

{
  "name": "Roee",
  "email": "roee@example.com",
  "password": "123456"
}

###
POST {{host}}/auth/login
content-type: application/json

{
  "email": "roee@example.com",
  "password": "123456"
}

###
GET {{host}}/users
Authorization: Bearer {{token}}
